limit_req_zone $binary_remote_addr zone=analyze_limit:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=addr_conn:10m;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 8k;
    location /api/health/ready { return 404; }
    location /api/metrics { return 404; }

    location /api/analyze {
        limit_req zone=analyze_limit burst=3 nodelay;
        limit_conn addr_conn 5;
        limit_req_status 429;
        limit_conn_status 429;

        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Autopsy-Client-IP $remote_addr;
        proxy_set_header X-Autopsy-Proxy-Secret "${TRUSTED_PROXY_SECRET}";
        proxy_read_timeout 65s;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Autopsy-Client-IP $remote_addr;
        proxy_set_header X-Autopsy-Proxy-Secret "${TRUSTED_PROXY_SECRET}";
        proxy_read_timeout 65s;
    }
}
