# Optional; increases public GitHub API limits. Keep this value server-side.
GITHUB_TOKEN=
# Required shared PostgreSQL database. Run npm run db:migrate before startup.
DATABASE_URL=postgresql://autopsy:CHANGE_ME@localhost:5432/autopsy
# Required, independent random URL-safe secrets of at least 32 characters.
# The reverse proxy must overwrite both x-autopsy-* headers; do not expose app ports.
TRUSTED_PROXY_SECRET=
MONITORING_TOKEN=
# Docker Compose database password; independent random URL-safe secret.
POSTGRES_PASSWORD=
# Development-only file adapter; never used in production without PostgreSQL.
REPORT_STORAGE_DIR=
# Optional AI explanation; both values must be set. Choose a Structured Outputs model.
OPENAI_API_KEY=
OPENAI_MODEL=
